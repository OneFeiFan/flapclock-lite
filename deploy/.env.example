# 翻牌钟简化版 · 部署脚本配置
#
# 用法：复制本文件为 deploy/.env 后按需修改；deploy/deploy.mjs 会读它。
# .gitignore 已忽略 *.env，真实配置不会进版本库。
#
# 前提：本机到服务器的 ssh 免密登录已经配好。还没配的话，
# 在 poker-timer-platform 仓库里跑一次 `node deploy/setup-ssh.mjs`（用密码装公钥，只需一次），
# 之后 ssh/scp 都不再需要密码。

# 目标服务器（ssh 可登录的地址）
DEPLOY_HOST=root@你的服务器IP

# ssh 端口
DEPLOY_PORT=22

# 服务器上的目录
FLAPCLOCK_DIR=/opt/flapclock
# 边缘扩展点：各项目的 vhost 与证书都放这里，由持有 80/443 的 poker-timer-web 只读挂载
EDGE_DIR=/opt/edge

# 对外域名。它就是正式版 APK 里硬编码的 origin（-PtvOrigin=https://域名/tv/），
# 定下来不要再改：换域名就要重新打包 APK，所有电视都要重装
DOMAIN=你的域名

# 持有 80/443 的边缘容器名（填这台服务器上那个边缘网关容器的名字）
EDGE_CONTAINER=poker-timer-web
# poker-timer 的安装根目录（只在一键修复边缘扩展点时才会碰它）
POKER_TIMER_DIR=/opt/poker-timer

# 可选的本地证书目录：成对的 <域名>.pem / <域名>.key，会随部署上传到 $EDGE_DIR/certs。
# 留空用 deploy/certs-local/。证书没准备好时部署会跳过边缘 vhost 安装并明确提示。
CERTS_DIR=
