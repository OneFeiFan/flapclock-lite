# 翻牌钟简化版 · Nginx 配置模板
# 放在 http {} 里（例如 /etc/nginx/conf.d/flapclock.conf），把域名、证书路径、端口改成实际值。
# 需要独立的（子）域名：页面使用 /、/tv/、/api、/ws 这些根路径，不支持挂在别的网站的子目录下。

map $http_upgrade $flapclock_connection {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name flapclock.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name flapclock.example.com;

    # 证书必须被安卓 6 信任：不要用 Let's Encrypt（安卓 7.1 以下不认它的根证书）
    ssl_certificate     /etc/nginx/ssl/flapclock.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/flapclock.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;     # 安卓 6 支持 TLS 1.2

    # 实时通道：大屏和手机都长期保持连接
    location /ws {
        proxy_pass http://127.0.0.1:18630;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $flapclock_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:18630;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
