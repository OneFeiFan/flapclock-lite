{
  "name": "flapclock-lite",
  "version": "1.0.0",
  "private": true,
  "description": "翻牌钟：扑克锦标赛计时与大屏系统",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server start",
    "dev:web": "npm --prefix web run dev",
    "test": "npm --prefix server test",
    "lan": "npm run build && node server/index.js --lan"
  }
}
