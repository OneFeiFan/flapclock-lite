# ============================================================
# 换行符规则
# 背景：本机是 Windows（core.autocrlf=true），默认会把文件存成 CRLF；
# 但服务器是 Linux，带 CRLF 的脚本会直接报 /bin/bash^M 跑不起来。
# 所以：部署给 Linux 用的文件一律强制 LF。
# ============================================================

# 默认：自动识别文本文件，仓库内部统一按 LF 存放
* text=auto

# ---- 直接部署到 Linux 的文件，必须是 LF ----
deploy/**        text eol=lf
*.sh             text eol=lf
*.service        text eol=lf
*.conf           text eol=lf
*.env.example    text eol=lf

# ---- Windows 专用脚本，必须是 CRLF ----
*.bat            text eol=crlf
*.cmd            text eol=crlf

# ---- 二进制文件，不做任何换行转换 ----
*.png            binary
*.jpg            binary
*.jpeg           binary
*.gif            binary
*.ico            binary
*.webp           binary
*.woff           binary
*.woff2          binary
*.ttf            binary
*.otf            binary
*.jar            binary
*.zip            binary
*.apk            binary
