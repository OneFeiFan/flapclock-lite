# 翻牌钟简化版 · systemd 服务
# 安装：sudo cp deploy/flapclock.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now flapclock
[Unit]
Description=Flapclock Lite (poker tournament clock)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flapclock
Group=flapclock
WorkingDirectory=/opt/flapclock
EnvironmentFile=/etc/flapclock/flapclock.env
ExecStart=/usr/bin/node server/index.js
# 收到 SIGTERM 时服务会先把数据写盘再退出
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/flapclock

[Install]
WantedBy=multi-user.target
