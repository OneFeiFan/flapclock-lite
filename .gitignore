# ============================================================
# 翻牌钟简化版（flapclock-lite）· 忽略规则
#
# 原则：只提交「人写的源码和文档」，不提交「机器生成的产物」和「含有你私有信息的文件」。
# 注意：这里挡住的东西**只影响 git**，文件还在磁盘上，程序照常能读能跑。
#       比如 deploy/certs-local/ 被挡了，deploy.mjs 一样读得到证书。
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 本机工具索引 ----------
# CodeGraph 是每台机器各建各的代码索引，数据库很大且因人而异
.codegraph/

# ---------- 构建产物 ----------
# 网页构建输出：拉下代码后跑 npm run build 自己生成
web/dist/
dist/
build/

# 安卓构建输出（Gradle 生成，体积大且每次构建都变）
tv-android/.gradle/
tv-android/build/
tv-android/app/build/
tv-android/app/release/
tv-android/app/debug/
*.apk
*.aab
*.ap_
*.dex
captures/

# ---------- 运行时的数据 ----------
# 赛事、屏幕、盲注方案的 JSON，跑起来才产生，属于你自己的业务数据
server/data/
*.db
*.sqlite
*.sqlite3

# ============================================================
# 部署目录里的私有部分（这一节最要紧）
# ============================================================

# 证书与私钥。
# 为什么整目录挡、而不是只挡 *.key / *.pem：
#   证书颁发机构给的 nginx 压缩包（deploy/ssl/*.zip）里**同样装着私钥**，
#   只按后缀挡会漏掉它。
# 为什么零容忍：
#   私钥一旦进了公开仓库，任何人都能伪装成你的域名做中间人攻击；
#   而且 git 历史是永久的，删掉文件也没用，只能吊销重签证书。
deploy/ssl/
deploy/certs-local/
**/certs-local/

# 部署打包产物：内容与源码重复，只是打了包（deploy.mjs 每次部署重新生成）
deploy/.ship/
deploy/.ship.tgz

# 边缘网关临时修复目录（deploy.mjs --repair-edge 的工作目录）
deploy/.repair/

# ---------- 密钥与私有配置（切勿提交）----------
# 安卓签名：提交了等于把 APK 的签名身份送人
*.jks
*.keystore
*.p12
*.pfx
tv-android/keystore.properties
tv-android/local.properties
local.properties

# 环境变量：真实值不提交，模板（.example）保留
.env
.env.*
*.env
!.env.example
!*.env.example

# 任何位置的私钥
*.pem
*.key
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
.ssh/

# ---------- 日志与临时文件 ----------
*.log
logs/
npm-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# ---------- 编辑器与系统 ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- 测试与覆盖率 ----------
coverage/
.nyc_output/
*.lcov
