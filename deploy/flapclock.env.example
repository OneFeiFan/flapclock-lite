# 翻牌钟简化版 · 服务器运行参数
#
# 安装位置：服务器上的 /opt/flapclock/.env
# 首次部署时由 deploy/deploy.mjs 从本模板生成，之后**不会被覆盖**（改过的值会保留）。
# 改完生效：
#   docker compose --env-file /opt/flapclock/.env -f /opt/flapclock/src/docker-compose.yml up -d

# 镜像 tag：用部署时间标记，回滚时能一眼看出容器里跑的是哪一次构建
FLAPCLOCK_TAG=local

# 数据目录（赛事、屏幕、盲注方案的 JSON 都在这里），必须纳入备份
FLAPCLOCK_DATA_DIR=/opt/flapclock/data

# 容器内监听端口。改这里必须同步改
# /opt/edge/conf.d/<你的域名>.conf 里的 proxy_pass，否则边缘会 502
FLAPCLOCK_PORT=18630

# 对外地址，只影响启动横幅（容器里打印容器内网地址会误导人）
PUBLIC_ORIGIN=https://你的域名

# 时区：所有屏幕都以服务器时间为准，不要设成 UTC
TZ=Asia/Shanghai

# 边缘网络：poker-timer 的 compose 项目网络（项目名 current → current_default）。
# 本服务接入它，边缘容器才能按名字 flapclock-app 访问到本服务
EDGE_NETWORK=current_default
